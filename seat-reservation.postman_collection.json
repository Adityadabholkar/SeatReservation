{
  "info": {
    "name": "Seat Reservation - smoke tests",
    "description": "Import, set baseUrl/adminToken in Collection variables, then Run collection (keep the order). Each request has tests. Postman cannot prove race-safety; use ./burst.sh for concurrency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & metrics",
      "item": [
        {
          "name": "Liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          }
        },
        {
          "name": "Readiness (checks DB)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and database UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().checks.database).to.eql('UP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            }
          }
        },
        {
          "name": "Metrics (Prometheus)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('has confirmed counter', () => pm.expect(pm.response.text()).to.include('reservations_confirmed_total'));",
                  "pm.test('has declined counter by reason', () => pm.expect(pm.response.text()).to.include('reservations_declined_total'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Correctness (run in order)",
      "item": [
        {
          "name": "Create show (admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('showId', j.id);",
                  "pm.test('6 seats, all available', () => { pm.expect(j.total_seats).to.eql(6); pm.expect(j.available).to.eql(6); pm.expect(j.seats.every(s => s.status === 'available')).to.be.true; });",
                  "pm.test('money is integer paise', () => pm.expect(Number.isInteger(j.price_paise)).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shows"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman-show\",\n  \"seats\": [\n    \"A1\",\n    \"A2\",\n    \"A3\",\n    \"A4\",\n    \"A5\",\n    \"A6\"\n  ],\n  \"price_paise\": 25000,\n  \"per_user_limit\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reserve A1 as user1 -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 confirmed', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('reservationId', j.reservation_id);",
                  "pm.test('status confirmed, 25000 paise, user from token', () => { pm.expect(j.status).to.eql('confirmed'); pm.expect(j.amount_paise).to.eql(25000); pm.expect(j.user_id).to.eql(pm.collectionVariables.get('user1')); pm.expect(j.seats).to.eql(['A1']); });"
                ]
